# Production variables, set in the Render dashboard (docs/deploy.md). Never commit real values.
# Local development needs none of them: run with the "local" profile (api/README.md).
SPRING_PROFILES_ACTIVE=prod
SPRING_DATASOURCE_URL=jdbc:postgresql://<neon-host>/<database>?sslmode=require
SPRING_DATASOURCE_USERNAME=finbot_app
SPRING_DATASOURCE_PASSWORD=
SPRING_FLYWAY_USER=<neon-owner-role>
SPRING_FLYWAY_PASSWORD=
# 32 random bytes as hex (openssl rand -hex 32); the same value as ORIGIN_SECRET on Vercel.
FINBOT_ORIGIN_SECRET=
